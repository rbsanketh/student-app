pipeline {
    agent {label "QA"}
    stages {
        stage('checkout') {
            steps {
                checkout([
                    $class: 'GitSCM'
                    branches: [[name: '*/main']],
                    userRemoteConfigs : [
                        url: 'https://github.com/rbsanketh/student-app.git',
                        credentialsId: 'github-pass'
                    ]
                ])
            }
        }
        stage('Build'){
            stages{
                sh 'mvn clean install'
            }
        }
        stage("Test"){
            steps {
                sh 'mvn test'
            }
        }
        stage('Deploy to Artifactory') {
            steps {
                configFileProvider([configFile(fileID: "41ac8627-466a-4919-99be-71c026f4b948", variable: 'MAVEN_SETTINGS')]) {
                    sh 'mvn deploy -s $MAVEN_SETTINGS'
                }
                
            }
        }

    }
}
