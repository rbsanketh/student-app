pipeline {
    agent { label "QA" }

    stages {

        stage('checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/rbsanketh/student-app.git',
                        credentialsId: 'github_pass'
                    ]]
                ])
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean install'
            }
        }

        stage('Test') {
            steps {
                sh "mvn test"
            }
        }

        stage('Deploy to Artifactory') {
            steps {
                configFileProvider([configFile(fileId: "http://16.171.152.236:8081/artifactory", variable: "MAVEN_SETTINGS")]) {
                    sh 'mvn deploy -s $MAVEN_SETTINGS'
                }
            }
        }
    }
}



